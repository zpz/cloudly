#!/usr/bin/env bash

if [[ "$(uname -o)" == "Msys" ]]; then
    export MSYS2_ARG_CONV_EXCL='*'
fi

PROJHOME=$(pwd)
PROJ=$(basename ${PROJHOME})
DOCKERHOME=/home/docker-user/${PROJ}

docker run \
    --env-file=dev.env \
    -v "$(dirname $(dirname ${PROJHOME}))/gcp_creds:/tmp/gcp_creds" \
    -v "${PROJHOME}:${DOCKERHOME}" \
    -w "${DOCKERHOME}" \
    -e PYTHONPATH=${DOCKERHOME}/src \
    -it --rm --init \
    cloudly:dev $@

